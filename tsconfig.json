{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowJs": true,
    "baseUrl": "src",
    "types": [
      "vite/client",
      "react",
      "react-dom",
      "react-router-dom",
      "react-icons",
      "axios",
      "dexie",
      "localforage"
    ]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}